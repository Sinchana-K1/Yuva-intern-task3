document.addEventListener("DOMContentLoaded", () => {
    const modal = document.getElementById("regModal");
    const openModalBtn = document.getElementById("openModalBtn");
    const closeModalBtn = document.getElementById("closeModalBtn");
    const regForm = document.getElementById("regForm");
    const filterButtons = document.querySelectorAll(".filter-btn");
    const cards = document.querySelectorAll(".card");

    // --- FEATURE 1: INTERACTIVE MODAL OVERLAY ---
    openModalBtn.addEventListener("click", () => { modal.style.display = "flex"; });
    closeModalBtn.addEventListener("click", () => { modal.style.display = "none"; });
    window.addEventListener("click", (e) => { if (e.target === modal) { modal.style.display = "none"; } });

    // --- FEATURE 2: REGISTRATION FORM VALIDATION ---
    regForm.addEventListener("submit", (e) => {
        e.preventDefault();
        const fullName = document.getElementById("fullName").value.trim();
        const email = document.getElementById("email").value.trim();
        let isValid = true;

        if (fullName === "") {
            document.getElementById("nameError").innerText = "Full name cannot be blank.";
            isValid = false;
        } else {
            document.getElementById("nameError").innerText = "";
        }

        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (email === "") {
            document.getElementById("emailError").innerText = "Email address is required.";
            isValid = false;
        } else if (!emailPattern.test(email)) {
            document.getElementById("emailError").innerText = "Please enter a valid format (e.g., name@domain.com).";
            isValid = false;
        } else {
            document.getElementById("emailError").innerText = "";
        }

        if (isValid) {
            alert(`Registration Successful! Welcome aboard, ${fullName}.`);
            regForm.reset();
            modal.style.display = "none";
        }
    });

    // --- FEATURE 3: DYNAMIC EVENTS FILTERS ---
    filterButtons.forEach(button => {
        button.addEventListener("click", () => {
            filterButtons.forEach(btn => btn.classList.remove("active"));
            button.classList.add("active");
            const targetedFilter = button.getAttribute("data-category");

            cards.forEach(card => {
                const itemCategory = card.getAttribute("data-type");
                if (targetedFilter === "all" || itemCategory === targetedFilter) {
                    card.style.display = "block";
                    setTimeout(() => card.style.opacity = "1", 50);
                } else {
                    card.style.opacity = "0";
                    card.style.display = "none";
                }
            });
        });
    });
});
